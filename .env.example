# .env.example
# Copie este arquivo para .env e preencha com seus valores reais

# IMPORTANTE: Nunca commite o arquivo .env no git!
# Adicione .env ao .gitignore

# Secret key para sessões Flask (gere uma chave aleatória forte)
# Gerar com: python -c "import secrets; print(secrets.token_hex(32))"
# ATENÇÃO: com FLASK_ENV=production o app se RECUSA a subir se esta chave for o
# placeholder. Preencha com uma chave real antes de rodar em produção.
SECRET_KEY=

# Database URL
# Desenvolvimento: sqlite:///xampuparaossos.db
# Produção: postgresql://user:password@host:port/database
DATABASE_URL=sqlite:///xampuparaossos.db

# Flask environment: development | production | testing
# IMPORTANTE: em produção use 'production' — é o que ativa cookies Secure,
# SameSite e desliga o debug (via config.py).
FLASK_ENV=development

# Flask debug mode (NUNCA usar True em produção!)
# Só tem efeito ao rodar `python run.py`; default é False.
FLASK_DEBUG=False
